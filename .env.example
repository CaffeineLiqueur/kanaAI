# JPLearning Environment Variables

# AI Provider (anthropic or openai)
AI_PROVIDER=anthropic

# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/jplearning

# Session JWT secret, at least 32 random characters
SESSION_SECRET=replace_with_at_least_32_random_characters

# Optional local TTS engine. Core lessons remain usable when it is offline.
VOICEVOX_ENGINE_URL=http://localhost:50027

# Local seed account (required only when running `npm run db:seed`)
# Never reuse this password for a real account.
SEED_USER_NAME=开发者
SEED_USER_EMAIL=dev@example.com
SEED_USER_PASSWORD=replace_with_a_local_only_password
